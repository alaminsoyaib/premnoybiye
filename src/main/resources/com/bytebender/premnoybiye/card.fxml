<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.MotionBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxWidth="-Infinity" prefWidth="200.0" spacing="16.0" stylesheets="@application.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox>
         <children>
            <StackPane fx:id="imgStack">
               <children>
                  <ImageView fx:id="blurImg" fitHeight="358.0" fitWidth="258.0" pickOnBounds="true" preserveRatio="true" styleClass="card-img">
                     <image>
                        <Image url="@img/icon/card-img.png" />
                     </image>
                     <effect>
                        <MotionBlur angle="360.0" radius="51.8" />
                     </effect>
                  </ImageView>
                  <ImageView fx:id="cardImg" fitHeight="358.0" fitWidth="258.0" pickOnBounds="true" preserveRatio="true" styleClass="card-img">
                     <image>
                        <Image url="@img/icon/card-img.png" />
                     </image>
                  </ImageView>
               </children>
            </StackPane>
            <VBox spacing="12.0">
               <VBox.margin>
                  <Insets bottom="7.0" left="14.0" right="14.0" top="14.0" />
               </VBox.margin>
               <children>
                  <VBox maxHeight="-Infinity" maxWidth="1.7976931348623157E308" spacing="4.0">
                     <children>
                        <Label fx:id="cardName" styleClass="card-title" text="Label">
                           <font>
                              <Font name="Trebuchet MS Bold" size="20.0" />
                           </font>
                        </Label>
                        <Label fx:id="cardBio" maxWidth="300.0" minWidth="200.0" opacity="0.5" prefWidth="200.0" styleClass="card-subtitle" text="Lorem ipsum dolor sit amet consectetur. Odio posuere risus ac lacus tellus at. Quis donec viverra dictumst etiam purus." textOverrun="CLIP" wrapText="true">
                           <font>
                              <Font name="Trebuchet MS" size="12.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <HBox maxWidth="1.7976931348623157E308" spacing="24.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                           <children>
                              <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@img/icon/location-icon.png" />
                                 </image>
                              </ImageView>
                              <Label fx:id="cardLocation" text="Noakhali">
                                 <font>
                                    <Font name="Trebuchet MS" size="12.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" layoutX="10.0" layoutY="10.0" spacing="6.0">
                           <children>
                              <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@img/icon/baby-icon.png" />
                                 </image>
                              </ImageView>
                              <Label fx:id="cardAge" text="24">
                                 <font>
                                    <Font name="Trebuchet MS" size="12.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="14.0" left="8.0" right="8.0" top="8.0" />
   </padding>
   <styleClass>
      <String fx:value="card-shadow" />
      <String fx:value="card-stack" />
   </styleClass>
   <cursor>
      <Cursor fx:constant="HAND" />
   </cursor>
</VBox>
